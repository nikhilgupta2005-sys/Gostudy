# ── Database ────────────────────────────────────────────────
# Local development: a SQLite file on disk.
DATABASE_URL="file:./data/gostudy.db"

# Production (Vercel or any serverless host): a hosted Turso database.
# A file: URL is refused in production because serverless storage is discarded.
# DATABASE_URL="libsql://your-db-your-org.turso.io"
# DATABASE_AUTH_TOKEN="..."

# ── Sessions ────────────────────────────────────────────────
# Any long random string. Changing it does not log anyone out (sessions live in
# the database), but keep it secret and out of version control.
SESSION_SECRET="change-me-to-a-long-random-string"

# ── First admin account ─────────────────────────────────────
# Only read the first time the database is seeded.
ADMIN_NAME="GoStudy Admin"
ADMIN_EMAIL="admin@gostudy.in"
ADMIN_PASSWORD="change-me"

# ── Image / video uploads ───────────────────────────────────
# local | vercel-blob | cloudinary
# Leave unset to auto-detect: Blob token → vercel-blob, Cloudinary vars →
# cloudinary, otherwise local.
# STORAGE_DRIVER="vercel-blob"

# Vercel Blob — created for you when you add a Blob store in the Vercel dashboard
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Cloudinary — the free-tier alternative
# CLOUDINARY_CLOUD_NAME="..."
# CLOUDINARY_API_KEY="..."
# CLOUDINARY_API_SECRET="..."
# CLOUDINARY_FOLDER="gostudy"

# ── Enquiry email alerts ────────────────────────────────────
# Who receives them and whether they're on is set in the dashboard
# (Home Page tab). These variables only choose how mail is sent.
# Without a key, alerts are written to the server log instead.
#
# resend | brevo | log  (auto-detected from whichever key is present)
# MAIL_DRIVER="resend"

# resend.com — 3,000 emails/month free
# RESEND_API_KEY="re_..."

# brevo.com — 300 emails/day free
# BREVO_API_KEY="xkeysib-..."

# Must be an address on a domain you have verified with the provider
# MAIL_FROM="GoStudy <orders@gostudy.in>"

# ── Site ────────────────────────────────────────────────────
# NEXT_PUBLIC_SITE_URL="https://gostudy.in"
